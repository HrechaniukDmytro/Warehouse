@page "/products/new"
@page "/products/{Id}"
@rendermode InteractiveServer
@inject ProductsApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Редагування товару" : "Новий товар")</PageTitle>

<h3>@(IsEdit ? "Редагування товару" : "Новий товар")</h3>

@if (notFound)
{
    <div class="alert alert-warning">
        Запис не знайдено — можливо, його вже видалили.
        <a href="/products" class="alert-link">Повернутися до списку</a>
    </div>
}
else if (loading)
{
    <p><em>Завантаження...</em></p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (serverErrors is { Count: > 0 })
    {
        <div class="alert alert-danger">
            <strong>Помилки валідації сервера:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var kvp in serverErrors)
                {
                    foreach (var msg in kvp.Value)
                    {
                        <li><strong>@kvp.Key:</strong> @msg</li>
                    }
                }
            </ul>
        </div>
    }

    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="ProductForm" class="card p-4 shadow-sm" style="max-width: 550px;">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Артикул (SKU)</label>
            <InputText class="form-control" @bind-Value="model.Sku" placeholder="Наприклад: A-100" />
            <ValidationMessage For="@(() => model.Sku)" class="text-danger small" />
        </div>

        <div class="mb-3">
            <label class="form-label">Назва товару</label>
            <InputText class="form-control" @bind-Value="model.Name" placeholder="Наприклад: Цемент М400" />
            <ValidationMessage For="@(() => model.Name)" class="text-danger small" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Кількість</label>
                <InputNumber class="form-control" @bind-Value="model.Quantity" />
                <ValidationMessage For="@(() => model.Quantity)" class="text-danger small" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Одиниця виміру</label>
                <InputText class="form-control" @bind-Value="model.Unit" placeholder="шт, мішок, кг" />
                <ValidationMessage For="@(() => model.Unit)" class="text-danger small" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? "Збереження..." : "Зберегти")
            </button>
            <a class="btn btn-outline-secondary" href="/products">Скасувати</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public string? Id { get; set; }

    private bool IsEdit => !string.IsNullOrWhiteSpace(Id);
    private ProductModel model = new();
    private bool loading = true;
    private bool saving;
    private bool notFound;
    private string? errorMessage;
    private Dictionary<string, string[]>? serverErrors;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        notFound = false;
        errorMessage = null;
        serverErrors = null;

        if (!IsEdit)
        {
            model = new ProductModel();
            loading = false;
            return;
        }

        try
        {
            var found = await Api.FindAsync(Id!);
            if (found is null)
            {
                notFound = true;
            }
            else
            {
                model = found;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "API недоступний. Перевірте, чи запущено src/Api.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;
        serverErrors = null;

        var result = IsEdit
            ? await Api.UpdateAsync(model)
            : await Api.CreateAsync(model);

        saving = false;

        if (result.Ok)
        {
            Nav.NavigateTo("/products");
            return;
        }

        errorMessage = result.Message;
        serverErrors = result.Errors;
    }
}